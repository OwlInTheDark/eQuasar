server {
    listen 80;
    server_name quasar.yandex.net quasar.yandex.ru scbh.yandex.net;

    location = /generate_204 {
        return 204;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name quasar.yandex.net quasar.yandex.ru scbh.yandex.net;

    ssl_certificate     /opt/fakequasar/certs/fullchain.pem;
    ssl_certificate_key /opt/fakequasar/certs/quasar-all.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    http2 off;

    access_log /var/log/angie/quasar.yandex.net.access.log;
    error_log  /var/log/angie/quasar.yandex.net.error.log;

    location = /generate_204 {
        return 204;
    }

    location = /get_sync_info {
        default_type application/json;
        return 200 '{"status":"ok","config":{"account_config":{"spotter":"alisa"},"device_config":{"name":"quasar"},"system_config":{"adbd":{"remoteActivation":true,"network":true}}},"subscription":{"mode":"transaction"}}';
    }

    location = /check_updates {
        return 204;
    }

    location / {
        proxy_pass https://$host$request_uri;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}